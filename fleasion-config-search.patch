diff --git a/tests/test_replacer_config_menu.py b/tests/test_replacer_config_menu.py
index 5a40a41..361e81f 100644
--- a/tests/test_replacer_config_menu.py
+++ b/tests/test_replacer_config_menu.py
@@ -286,3 +286,74 @@ def test_replacer_explains_portable_configs_asset_path(tmp_path, monkeypatch):
     finally:
         window.close()
     assert app is not None
+
+
+def test_searchable_config_menu_filters_rows():
+    app = _qapp()
+    popup = _ScrollableConfigMenu(checkable=True, searchable=True)
+    popup.set_entries(
+        [
+            {'name': 'Sniper Skin Red', 'checked': False},
+            {'name': 'Sniper Skin Blue', 'checked': False},
+            {'name': 'Skybox Night', 'checked': True},
+        ],
+        minimum_width=120,
+    )
+    full_height = popup.scroll_area.height()
+    full_width = popup.scroll_area.width()
+    assert popup.search_edit is not None
+
+    popup.search_edit.setText('sniper')
+    assert popup.visible_names() == ['Sniper Skin Red', 'Sniper Skin Blue']
+    assert popup.scroll_area.height() < full_height
+    assert popup.scroll_area.width() == full_width
+
+    popup.search_edit.setText('BLUE sniper')
+    assert popup.visible_names() == ['Sniper Skin Blue']
+
+    popup.search_edit.setText('nothing here')
+    assert popup.visible_names() == []
+    assert popup._no_match_label is not None
+    assert not popup._no_match_label.isHidden()
+
+    popup.clear_search()
+    assert popup.visible_names() == ['Sniper Skin Red', 'Sniper Skin Blue', 'Skybox Night']
+    assert popup.scroll_area.height() == full_height
+    assert app is not None
+
+
+def test_searchable_config_menu_enter_toggles_first_match():
+    from PyQt6.QtGui import QKeyEvent
+
+    app = _qapp()
+    popup = _ScrollableConfigMenu(checkable=True, searchable=True)
+    popup.set_entries(
+        [{'name': 'Alpha', 'checked': False}, {'name': 'Beta', 'checked': False}],
+        minimum_width=120,
+    )
+    toggles = []
+    popup.item_toggled.connect(lambda name, checked: toggles.append((name, checked)))
