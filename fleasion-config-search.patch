+    def _build_search_box(self) -> None:
+        """Add a filter box above the config rows."""
+        container = QWidget()
+        container.setObjectName('ConfigMenuSearchContainer')
+        layout = QVBoxLayout(container)
+        layout.setContentsMargins(6, 6, 6, 4)
+        layout.setSpacing(0)
+
+        edit = QLineEdit()
+        edit.setObjectName('ConfigMenuSearch')
+        edit.setPlaceholderText(tr('ui.gui.replacer_config.search_configs'))
+        edit.setClearButtonEnabled(True)
+        edit.textChanged.connect(self._apply_filter)
+        edit.installEventFilter(self)
+        layout.addWidget(edit)
+
+        self.search_edit = edit
+        self._search_container = container
+        search_action = QWidgetAction(self)
+        search_action.setDefaultWidget(container)
+        self.addAction(search_action)
+        # Each open starts with an empty search
+        self.aboutToShow.connect(self.clear_search)
+
+    def clear_search(self) -> None:
+        """Reset the search text so every config is listed again."""
+        if self.search_edit is not None and self.search_edit.text():
+            self.search_edit.clear()
+
+    def _search_height(self) -> int:
+        if self._search_container is None:
+            return 0
+        return self._search_container.sizeHint().height()
+
     def sizeHint(self):  # noqa: N802
         """Use the embedded scroll area's size without rebuilding the action."""
         if self._natural_content_size.isValid() and self.scroll_area.size().isValid():
-            return self.scroll_area.size()
+            size = self.scroll_area.size()
+            return QSize(size.width(), size.height() + self._search_height())
         return super().sizeHint()
 
+    def showEvent(self, a0: QShowEvent | None) -> None:  # noqa: N802
+        super().showEvent(a0)
+        if self.search_edit is not None:
+            # Defer so the popup owns keyboard focus before the box claims it
+            QTimer.singleShot(0, self._focus_search)
+
+    def _focus_search(self) -> None:
+        if self.search_edit is not None and self.isVisible():
+            self.search_edit.setFocus(Qt.FocusReason.PopupFocusReason)
+
+    @staticmethod
+    def _matches(name: str, terms: list[str]) -> bool:
+        lowered = name.casefold()
+        return all(term in lowered for term in terms)
+
+    def visible_names(self) -> list[str]:
+        """Names of the config rows shown under the current search."""
+        return [name for name, row in self.item_widgets.items() if not row.isHidden()]
+
+    def _apply_filter(self, *_args: object) -> None:
+        """Show only the rows whose name contains every search word."""
+        if not self.item_widgets:
+            return
+        text = self.search_edit.text() if self.search_edit is not None else ''
+        terms = text.casefold().split()
+        visible = 0
+        for name, row in self.item_widgets.items():
+            match = self._matches(name, terms)
+            row.setHidden(not match)
+            visible += int(match)
+
+        if self._no_match_label is not None:
+            self._no_match_label.setHidden(visible > 0)
+        self._content_height = max(1, visible) * _CONFIG_MENU_ROW_HEIGHT_PX
+
+        anchored_above = False
+        old_bottom = 0
+        owner = self.parentWidget()
+        if self.isVisible() and owner is not None:
+            # A popup that opened above its button keeps its bottom edge in place
+            old_bottom = self.geometry().bottom()
+            anchored_above = old_bottom <= owner.mapToGlobal(owner.rect().topLeft()).y()
+
+        self._set_popup_content_size(
+            self._max_height if self._max_height is not None else self._content_height,
+            max_width=self._max_width,
+        )
+        self._reset_action_geometry()
+
+        if anchored_above:
+            geometry = self.geometry()
+            geometry.moveBottom(old_bottom)
+            self.setGeometry(geometry)
+
+    def _toggle_first_match(self) -> None:
+        """Toggle (or pick) the first visible row, for Enter in the search box."""
+        for row in self.item_widgets.values():
+            if not row.isHidden() and isinstance(row, _ConfigMenuRow):
+                row.click()
+                return
